# Normalise line endings so the repo is consistent across
# Windows, macOS and Linux.
* text=auto eol=lf

# Shell scripts must stay LF even on Windows
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.mov binary
*.pdf binary

# Lockfiles are generated by package managers
frontend/package-lock.json -diff
