# ===========================================
# AakSidhi Automation - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values you need.
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# .env is git-ignored. Never commit real credentials.

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- Security ---
# REQUIRED. Generate a unique value for every deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# This signs every access token, so anyone who knows it can impersonate
# any user. The app refuses to start in production if it is unset.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- Database ---
# Inside Docker the host is `postgres`, not `localhost`.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aksidhi
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
REDIS_CELERY_BROKER_URL=redis://redis:6379/1
REDIS_CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Storage (S3-compatible) ---
# Leave S3_ENDPOINT empty to store uploads on the local filesystem.
# For AWS S3, Cloudflare R2 or Supabase Storage set the endpoint and keys.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=aksidhi-media
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PROVIDER=local

# --- Social OAuth ---
# Create an app at each provider's developer console and paste the
# credentials here. Leave blank to keep a platform disabled.
# The redirect URI must match the value registered with the provider.

# Facebook / Meta
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/social-accounts/facebook/callback

# Instagram (uses the Meta Graph API)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/social-accounts/instagram/callback

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/social-accounts/linkedin/callback

# WhatsApp Business (Meta Cloud API)
WHATSAPP_CLIENT_ID=
WHATSAPP_CLIENT_SECRET=
WHATSAPP_REDIRECT_URI=http://localhost:8000/api/social-accounts/whatsapp/callback

# --- AI caption assistant (optional) ---
# Runs fully locally. If Ollama is not running, everything except the
# AI assistant keeps working.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b
# Vision model used to read an uploaded image. Install once:
#   ollama pull llava
OLLAMA_VISION_MODEL=llava

# --- CORS ---
# Comma separated. When sharing the app publicly, add the public
# hostname here as well.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Email (optional, for notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# --- Initial admin user ---
# Used by: python -m app.scripts.seed_admin
# Change ADMIN_PASSWORD before exposing the app to the internet.
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin
