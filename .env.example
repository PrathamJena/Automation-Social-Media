# ===========================================
# AakSidhi Automation - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Application ---
APP_NAME=AakSidhi Automation
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- Security ---
SECRET_KEY=change_this_to_a_random_64_char_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aksidhi
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_CELERY_BROKER_URL=redis://localhost:6379/1
REDIS_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Storage (S3-Compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aksidhi-media
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PROVIDER=minio

# --- Social OAuth: Meta/Facebook ---
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/social-accounts/facebook/callback

# --- Social OAuth: Instagram ---
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/social-accounts/instagram/callback

# --- Social OAuth: LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/social-accounts/linkedin/callback

# --- Social OAuth: WhatsApp Business ---
WHATSAPP_CLIENT_ID=
WHATSAPP_CLIENT_SECRET=
WHATSAPP_REDIRECT_URI=http://localhost:8000/api/social-accounts/whatsapp/callback

# --- AI Provider ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# Vision model used to read images and write captions.
# Install once with:  ollama pull llava
OLLAMA_VISION_MODEL=llava

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Email (for notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aksidhi.com
